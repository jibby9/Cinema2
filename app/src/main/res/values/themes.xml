<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="Theme.AppCompat.NoActionBar">
        <!-- Force non-translucent background colors required by MediaRouterThemeHelper -->
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:colorBackground">#FF121212</item>
        <item name="android:colorBackgroundFloating">#FF121212</item>
        <item name="android:windowIsTranslucent">false</item>
        <!-- Standard AppCompat themed elements -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
    </style>

    <!-- Style overlay to prevent transparency crashes inside MediaRouteButton -->
    <style name="ThemeOverlay.CastButton" parent="Theme.AppCompat.NoActionBar">
        <!-- Force non-translucent background colors required by MediaRouterThemeHelper -->
        <item name="android:colorBackground">#FF121212</item>
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:colorBackgroundFloating">#FF121212</item>
    </style>
</resources>
